# Local secrets (API keys / endpoints) — DO NOT COMMIT
lib/config/secrets.dart

# Android signing artifacts — DO NOT COMMIT
android/key.properties
android/upload-keystore.jks
android/*.jks
android/**/*.keystore

# WorkBuddy private memory (user preferences / project notes) — DO NOT COMMIT
.workbuddy/

# WorkBuddy generated delivery artifact (not project source)
overview.md

