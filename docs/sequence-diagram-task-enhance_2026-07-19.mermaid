%% =====================================================================
%% SD1: 语音录入 → 云端解析 → 参数填实 → UI 反馈（成功经路由回传）
%% =====================================================================
sequenceDiagram
    autonumber
    actor U as 用户
    participant VT as VoiceInputScreen
    participant PL as PromptLoader
    participant AS as AliyunScheduleService
    participant CD as ConflictDetector
    participant TS as TaskStore
    participant RM as ReminderService
    participant TT as TasksTab
    participant FB as TaskFeedbackCard

    U->>VT: 录音并解析
    VT->>PL: byId('tasks_voice').prompt (app 启动时已 loadAll 缓存)
    VT->>AS: schedule(transcript, existing)
    AS->>AS: _callModel(prompt=YAML, existing)  // 删内联 prompt，YAML 为单一真源
    AS->>AS: parseJson(resp)
    Note over AS: 读 title/datetime/remind_in_seconds/duration_minutes/<br/>resource/repeat/weekdays/ring_seconds/note
    AS-->>VT: List~ScheduledTask~ (含 ringSeconds/resource/durationMinutes/repeat)
    VT->>CD: detect + applyDecision (每候选)
    VT-->>VT: _candidates (Task)
    VT->>U: 预览(_PreviewTile 展示 资源/时长/响铃/倒计时)
    U->>VT: 确认添加
    VT->>TS: addWithConflictCheck(每个选中)
    VT->>RM: notifyTaskChanged(已生效任务)
    VT-->>TT: Navigator.pop({'added':n,'conflict':k})
    TT->>FB: show(type=success, message='已添加 n 个任务')
    Note over FB: Overlay + 淡入上滑 → 停留 3s → 滑出淡出

%% =====================================================================
%% SD2: 云端失败 → 本地 NlpParser 回退 → 参数填实
%% =====================================================================
sequenceDiagram
    autonumber
    actor U as 用户
    participant VT as VoiceInputScreen
    participant AS as AliyunScheduleService
    participant NP as NlpParser
    participant CD as ConflictDetector
    participant TS as TaskStore

    U->>VT: 录音并解析
    VT->>AS: schedule(transcript, existing)
    AS->>AS: _callModel(prompt=YAML)  // 异常 / 非200 / JSON 非法
    AS-->>AS: catch → _fallback(transcript)
    AS->>NP: NlpParser.parse(transcript)
    Note over NP: 抽取 resource / durationMinutes / repeat语义<br/>(睡前→daily+23:00) / countdown / 标题去参
    NP-->>AS: List~ParsedTask~ (含 resource, durationMinutes)
    AS->>AS: _fallback 映射 → ScheduledTask(resource=p.resource, durationMinutes=p.durationMinutes??60, ringSeconds=null)
    AS-->>VT: List~ScheduledTask~ (本地回退，ringSeconds 留空走全局默认)
    VT->>CD: detect + applyDecision
    VT->>TS: addWithConflictCheck

%% =====================================================================
%% SD3: 滑动删除 → confirmDismiss → 确认 → 撤销
%% =====================================================================
sequenceDiagram
    autonumber
    actor U as 用户
    participant TL as TaskList
    participant TC as TaskCard
    participant TT as TasksTab
    participant DLG as AlertDialog(AppTheme)
    participant ST as TaskStore
    participant RM as ReminderService
    participant FB as TaskFeedbackCard

    U->>TC: 左滑 (endToStart，selectionMode 时为 none)
    TC->>TC: Dismissible.confirmDismiss(direction)
    TC->>TT: confirmDismiss() 回调(父级提供)
    TT->>DLG: showDialog('确定删除该任务？删除后可在下方提示中撤销', 取消/删除)
    alt 用户点取消
        DLG-->>TT: false
        TT-->>TC: false → Dismissible 自动回弹(不删)
    else 用户点删除
        DLG-->>TT: true
        TT-->>TC: true
        TC->>TT: onDismissed → onDelete(task)
        TT->>RM: cancelTask(task)
        TT->>ST: delete(task)
        TT->>FB: show(type=delete, message='已删除', onAction=撤销)
        FB-->>U: 卡片淡入上滑，停留 3s
        U->>FB: 点"撤销"
        FB->>TT: onAction()
        TT->>ST: add(原 task)
        TT->>RM: notifyTaskChanged(task)
        TT->>FB: show(type=undo, message='已撤销')
    end
